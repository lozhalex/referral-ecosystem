generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  phone          String    @unique
  passwordHash   String
  
  role           String    @default("user")
  isRcbPaid            Boolean   @default(false) 
  rcbId                String?   
  rcbReferralLink      String?   
  isRcbRegisteredFree  Boolean   @default(false) 
  rcbPaymentRequested  Boolean   @default(false) 
  isPaidMember         Boolean   @default(false)
  referralCount        Int       @default(0)
  
  isFounder          Boolean   @default(false) 
  tokenVersion       Int       @default(1)
  isSuspicious       Boolean   @default(false)
  preferredContact   String?   

  referredById   Int?
  referredBy     User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("UserReferrals")
  
  pushSubscriptions PushSubscription[]
  
  wallet         Wallet?
  auditLogsAsAdmin   TreeAuditLog[] @relation("AuditAdmin")
  auditLogsAsTarget  TreeAuditLog[] @relation("AuditTarget")
  
  tickets            Ticket[]            @relation("TicketOwner")
  scannedTickets     Ticket[]            @relation("ScannerUser")
  eventsAsController EventController[]

  rcbRequestsSent     RcbRequest[] @relation("RcbRequestSender")
  rcbRequestsReceived RcbRequest[] @relation("RcbRequestReceiver")

  cars                   Car[]
  serviceRecords         ServiceRecord[]
  serviceRecordsAsAuthor ServiceRecord[] @relation("ServiceRecordAuthor")
  serviceInterval        ServiceInterval?
  masters                Master[]
  mileageChecks          MileageCheck[]
  autoSettings           UserAutoSettings?

  // 🆕 ЖКХ: квартиры и ачивки
  apartments             Apartment[]
  achievements           UserAchievement[]
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  serviceAccessQrsClient ServiceAccessQR[] @relation("ServiceAccessQRClient")
}

model Wallet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  balance      Int           @default(0)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id               String   @id @default(uuid())
  walletId         Int
  amount           Int
  totalAmount      Int      @default(0) 
  paidWithBonuses  Int      @default(0) 
  realMoneyAmount  Int      @default(0) 
  type             String   
  description      String
  status           String   @default("AVAILABLE")
  unlockDate       DateTime? 
  referenceId      String?
  createdAt        DateTime @default(now())
  wallet           Wallet   @relation(fields: [walletId], references: [id])
  
  @@index([status])
  @@index([unlockDate])
}

model TreeAuditLog {
  id            Int      @id @default(autoincrement())
  adminId       Int
  admin         User     @relation("AuditAdmin", fields: [adminId], references: [id])
  targetUserId  Int?
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id])
  action        String
  oldData       String?
  newData       String?
  createdAt     DateTime @default(now())
}

model Event {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  location       String?
  eventDate      DateTime
  price          Int       @default(1000)
  cashbackAmount Int       @default(50)
  referrerBonus  Int       @default(100)
  isActive       Boolean   @default(true)
  posterUrl      String?
  isFree         Boolean   @default(false)
  maxTickets     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  tickets        Ticket[]
  controllers    EventController[]
}

model Ticket {
  id          Int       @id @default(autoincrement())
  userId      Int
  eventId     Int
  qrCode      String    @unique
  status      String    @default("ACTIVE")
  scannedAt   DateTime?
  scannedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation("TicketOwner", fields: [userId], references: [id])
  event       Event     @relation(fields: [eventId], references: [id])
  scannedBy   User?     @relation("ScannerUser", fields: [scannedById], references: [id])
  
  @@unique([userId, eventId])
  @@index([qrCode])
  @@index([eventId, status])
}

model EventController {
  id        Int       @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime  @default(now())
  
  event     Event     @relation(fields: [eventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  
  @@unique([eventId, userId])
}

model RcbRequest {
  id              String   @id @default(uuid())
  userId          Int      
  referredById    Int?     
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation("RcbRequestSender", fields: [userId], references: [id])
  referredBy      User?    @relation("RcbRequestReceiver", fields: [referredById], references: [id])

  @@index([userId])
  @@index([referredById])
  @@index([status])
}

model Car {
  id          Int       @id @default(autoincrement())
  userId      Int
  marka       String    @default("")
  model       String    @default("")
  year        String    @default("")
  gosnomer    String    @default("")
  vin         String    @default("")
  mileage     Int       @default(0)
  isDeleted   Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id])
  records            ServiceRecord[]
  mileageChecks      MileageCheck[]
  serviceAccessQrs   ServiceAccessQR[]

  @@index([userId, isDeleted])
}

model ServiceRecord {
  id          Int       @id @default(autoincrement())
  carId       Int
  userId      Int
  date        String    @default("")
  mileage     Int       @default(0)
  category    String    @default("")
  subcat      String    @default("")
  work        String    @default("")
  cost        Int       @default(0)
  comment     String    @default("")
  
  createdAt   DateTime  @default(now())

  car         Car       @relation(fields: [carId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  author      User?     @relation("ServiceRecordAuthor", fields: [authorId], references: [id])

  @@index([carId, date])
  @@index([userId])
  
  source      String    @default("owner")
  authorId    Int?
}

model ServiceInterval {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  data        String    @default("{}")
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
}

model Master {
  id          Int       @id @default(autoincrement())
  userId      Int
  name        String    @default("")
  contact     String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  @@index([userId])
}

model MileageCheck {
  id          Int       @id @default(autoincrement())
  carId       Int
  userId      Int
  yearMonth   String
  km          Int       @default(0)
  checkDate   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  car         Car       @relation(fields: [carId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  @@unique([carId, yearMonth])
  @@index([userId])
}

model UserAutoSettings {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  mileageReminderTime   String    @default("09:00")
  disableOsagoReminder  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model ServiceAccessQR {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  carId     Int
  clientId  Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  
  car       Car      @relation(fields: [carId], references: [id])
  client    User     @relation("ServiceAccessQRClient", fields: [clientId], references: [id])
}

// ============================================================
// 🆕 МОДУЛЬ «СЧЕТЧИКИ ЖКХ»
// ============================================================

model Apartment {
  id         Int      @id @default(autoincrement())
  userId     Int
  comment    String
  billingDay Int      @default(20)
  isActive   Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meters     Meter[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Meter {
  id                   Int       @id @default(autoincrement())
  userId               Int
  apartmentId          Int
  type                 String    // 'HWS'|'GWS'|'DRINKING_WATER'|'ELECTRICITY'|'GAS'|'HEAT'
  tariffType           String    @default("SINGLE") // 'SINGLE'|'TWO_TARIFF'|'THREE_TARIFF'
  comment              String
  serialNumber         String
  initialReading       Float
  nextVerificationDate DateTime?
  sortOrder            Int       @default(0)
  isActive             Boolean   @default(true)

  apartment            Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  readings             MeterReading[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, sortOrder])
  @@index([apartmentId])
}

model MeterReading {
  id            Int      @id @default(autoincrement())
  meterId       Int
  periodKey     String   // 'YYYY-MM'

  prevT1        Float
  prevT2        Float?
  prevT3        Float?
  t1            Float
  t2            Float?
  t3            Float?

  ocrT1         Float?
  photoUrl      String?
  usedOcr       Boolean  @default(false)
  mlConsent     Boolean  @default(false)

  status        String   @default("confirmed") // 'confirmed'|'locked'|'change_requested'
  lockedAt      DateTime?

  meter         Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  changeRequests MeterChangeRequest[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([meterId, periodKey])
  @@index([meterId])
}

model MeterChangeRequest {
  id               Int      @id @default(autoincrement())
  readingId        Int
  userId           Int
  requestedT1      Float
  requestedT2      Float?
  requestedT3      Float?
  reason           String
  evidencePhotoUrl String
  status           String   @default("pending") // 'pending'|'approved'|'rejected'
  processedBy      Int?
  processedAt      DateTime?

  reading          MeterReading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())

  @@index([status])
}

model Achievement {
  id          Int    @id @default(autoincrement())
  code        String @unique
  title       String
  description String
  icon        String
  module      String   // 'zhkh'|'auto'|'global'

  users       UserAchievement[]
}

model UserAchievement {
  userId        Int
  achievementId Int
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}