generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  phone          String    @unique
  passwordHash   String
  role           String    @default("user") // "user", "admin", "controller", "system"
  
  // --- БЕЗОПАСНОСТЬ И ЗАЩИТА ---
  tokenVersion   Int       @default(1) // Пункт 6: Отзыв JWT-токенов
  isSuspicious   Boolean   @default(false) // Пункт 13: Защита от накрутки

  // --- ИНТЕГРАЦИЯ С РЦБ ---
  rcbId             String?   
  isRcbPaid         Boolean   @default(false) 
  rcbReferralLink   String?   

  isPaidMember   Boolean   @default(false)
  referralCount  Int       @default(0)
  
  referredById   Int?
  referredBy     User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals      User[]    @relation("UserReferrals")
  
  wallet         Wallet?
  auditLogsAsAdmin   TreeAuditLog[] @relation("AuditAdmin")
  auditLogsAsTarget  TreeAuditLog[] @relation("AuditTarget")
  
  tickets            Ticket[]            @relation("TicketOwner")
  scannedTickets     Ticket[]            @relation("ScannerUser")
  eventsAsController EventController[]

  rcbRequestsSent     RcbRequest[] @relation("RcbRequestSender")
  rcbRequestsReceived RcbRequest[] @relation("RcbRequestReceiver")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Wallet {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  balance      Int           @default(0)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id               String   @id @default(uuid())
  walletId         Int
  amount           Int
  
  // --- ПРОПОРЦИОНАЛЬНЫЙ РАСЧЕТ ---
  totalAmount      Int      @default(0) 
  paidWithBonuses  Int      @default(0) 
  realMoneyAmount  Int      @default(0) 
  
  type             String   
  description      String
  
  // --- МЕХАНИКА "В ОЖИДАНИИ" (String вместо enum для SQLite) ---
  // Допустимые значения: "PENDING", "AVAILABLE", "CANCELLED"
  status           String   @default("AVAILABLE")
  unlockDate       DateTime? 
  
  referenceId      String?
  createdAt        DateTime @default(now())
  wallet           Wallet   @relation(fields: [walletId], references: [id])
  
  @@index([status])
  @@index([unlockDate])
}

model TreeAuditLog {
  id            Int      @id @default(autoincrement())
  adminId       Int
  admin         User     @relation("AuditAdmin", fields: [adminId], references: [id])
  targetUserId  Int?
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id])
  action        String   // "MOVE", "IMPORT", "ROLE_CHANGE", "PASSWORD_RESET", "MEMBERSHIP_TOGGLE", "RCB_VERIFY"
  oldData       String?
  newData       String?
  createdAt     DateTime @default(now())
}

model Event {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  location       String?
  eventDate      DateTime
  price          Int       @default(1000) // Стоимость билета для расчетов
  cashbackAmount Int       @default(50)
  referrerBonus  Int       @default(100)  // Максимальный бонус при 100% оплате деньгами
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  tickets        Ticket[]
  controllers    EventController[]
}

model Ticket {
  id          Int       @id @default(autoincrement())
  userId      Int
  eventId     Int
  qrCode      String    @unique
  status      String    @default("ACTIVE") // "ACTIVE", "USED", "CANCELLED"
  scannedAt   DateTime?
  scannedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  user        User      @relation("TicketOwner", fields: [userId], references: [id])
  event       Event     @relation(fields: [eventId], references: [id])
  scannedBy   User?     @relation("ScannerUser", fields: [scannedById], references: [id])
  
  @@unique([userId, eventId])
  @@index([qrCode])
  @@index([eventId, status])
}

model EventController {
  id        Int       @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime  @default(now())
  
  event     Event     @relation(fields: [eventId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  
  @@unique([eventId, userId])
}

model RcbRequest {
  id              String   @id @default(uuid())
  userId          Int      
  referredById    Int      
  
  // Допустимые значения: "PENDING", "APPROVED", "REJECTED", "ESCALATED"
  status          String   @default("PENDING")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation("RcbRequestSender", fields: [userId], references: [id])
  referredBy      User     @relation("RcbRequestReceiver", fields: [referredById], references: [id])

  @@index([userId])
  @@index([referredById])
  @@index([status])
}